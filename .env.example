# FastAPI Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PREFIX=/api/v1

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hospital_clinical_mcp
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_HL7=hl7_messages
RABBITMQ_QUEUE_FHIR=fhir_resources
RABBITMQ_QUEUE_DICOM=dicom_metadata
RABBITMQ_QUEUE_DEVICE=device_telemetry

# HL7 Listener Configuration
HL7_LISTENER_HOST=0.0.0.0
HL7_LISTENER_PORT=2575
HL7_LISTENER_TIMEOUT=300

# FHIR Configuration
FHIR_SERVER_URL=https://fhir.hospital.local/fhir
FHIR_CLIENT_ID=mcp_server
FHIR_CLIENT_SECRET=your_secret_here
FHIR_OAUTH_TOKEN_URL=https://auth.hospital.local/oauth/token
FHIR_SYNC_INTERVAL=3600

# DICOM Configuration
DICOM_LISTENER_HOST=0.0.0.0
DICOM_LISTENER_PORT=11112
DICOM_AE_TITLE=MCP_SERVER
DICOM_ARCHIVE_URL=http://dicom-archive.hospital.local

# Device Telemetry Configuration
DEVICE_TELEMETRY_PORT=9000
DEVICE_TELEMETRY_TIMEOUT=60

# Authentication Configuration
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
OAUTH2_PROVIDER_URL=https://auth.hospital.local
LDAP_SERVER_URL=ldap://ldap.hospital.local
LDAP_BASE_DN=dc=hospital,dc=local

# Authorization Configuration
RBAC_ENABLED=true
CONSENT_CHECKING_ENABLED=true

# Security Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE"]
CORS_ALLOW_HEADERS=["*"]

# Audit Logging Configuration
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555
PHI_MASKING_ENABLED=true

# Performance Configuration
QUERY_TIMEOUT_SECONDS=30
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=100

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=60

# Logging Configuration
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=10

# Feature Flags
ENABLE_HL7_INGESTION=true
ENABLE_FHIR_INGESTION=true
ENABLE_DICOM_INGESTION=true
ENABLE_DEVICE_TELEMETRY=true
ENABLE_CACHING=true
ENABLE_AUDIT_LOGGING=true
